# =========================================================================
# TECHMIYA DRIVE REGISTRATION PORTAL - FRONTEND ENVIRONMENT CONFIGURATION
# =========================================================================
# NOTE: Only variables prefixed with VITE_ are exposed to the client browser.
# NEVER include the Supabase service_role key or Resend API key here!

# Supabase Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon Key (Protected by Row Level Security)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Google Apps Script Web App URL (For direct Google Sheet storage & email dispatch)
# e.g., https://script.google.com/macros/s/AKfycbx.../exec
VITE_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/your-deployment-id/exec

# Optional Custom Domain (Defaults to current window origin)
VITE_APP_URL=https://jobdrive.techmiyaedtech.com
